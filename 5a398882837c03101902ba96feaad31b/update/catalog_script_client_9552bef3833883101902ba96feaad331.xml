        <name>PopulateTodoLists</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onLoad() {
    var ga = new GlideAjax('TodoListFetcher');
    ga.addParam('sysparm_name', 'getLists');
    ga.getXML(populateLists);

    function populateLists(response) {
        var answer = response.responseXML.documentElement.getAttribute("answer");
        var lists = JSON.parse(answer);
        // Clear existing choices
        g_form.clearOptions('list_id');
        // Add new choices
        lists.forEach(function(list) {
            g_form.addOption('list_id', list.id, list.name);
        });
    }
}]]></script>
